# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.

# Duffel — test token from app.duffel.com → Developers → Access tokens (fallback when Travelpayouts returns nothing).
DUFFEL_ACCESS_TOKEN=

# Travelpayouts — API token from travelpayouts.com → Developers → API (enables real-time search + book links).
# Requires Search API access from Travelpayouts support.
TRAVELPAYOUTS_API_TOKEN=

# Optional: public IPv4 for local dev (Travelpayouts rejects 127.0.0.1 as user_ip). In production, rely on X-Forwarded-For.
# TRAVELPAYOUTS_USER_IP=

# Travelpayouts marker (affiliate id) — used for Kiwi deep links when using Duffel fallback, and required with TRAVELPAYOUTS_API_TOKEN.
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=
