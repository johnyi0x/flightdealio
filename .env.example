TRAVELPAYOUTS_API_TOKEN=
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=
# Base URL for data-API deal links (relative `link` from prices_for_dates is appended). Default: https://www.aviasales.com
# TRAVELPAYOUTS_DEAL_BASE_URL=https://www.aviasales.com
# Optional market for cached data (e.g. us)
# TRAVELPAYOUTS_DATA_MARKET=us
# If your site is www.* but Travelpayouts “Website” is apex (or the reverse), set this to match TP exactly:
# TRAVELPAYOUTS_VERIFIED_HOST=flightdealio.com
# TRAVELPAYOUTS_USER_IP=
# FLIGHT_RESULTS_CAP=80
# RATE_LIMIT_PLACES_PER_MIN=120
# RATE_LIMIT_FLIGHT_SEARCH_PER_MIN=30
# RATE_LIMIT_FLIGHT_POLL_PER_MIN=200
# RATE_LIMIT_FLIGHT_BATCH_POLL_PER_MIN=80
# RATE_LIMIT_FLIGHT_COMPILE_PER_MIN=40
# FLIGHT_POLL_ROUNDS_PER_REQUEST=4
# FLIGHT_POLL_GAP_MS=550
# RATE_LIMIT_BUDGET_SEARCH_PER_MIN=20
# RATE_LIMIT_TRAVELPAYOUTS_CLICK_PER_MIN=45
# RATE_LIMIT_DISABLED=1
